{
  "manifest_version": 3,
  "name": "Diff Hunk Review",
  "version": "0.1.0",
  "description": "Hide reviewed hunks and lines in GitHub and Bitbucket pull request diffs, like `git add -p` for code review.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Diff Hunk Review",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://bitbucket.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
