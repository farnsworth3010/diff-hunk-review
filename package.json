{
  "name": "diff-hunk-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch & vite build --watch --mode popup",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && vite build --mode popup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepare": "simple-git-hooks",
    "icons": "for size in 16 32 48 128; do inkscape assets/icon.svg -w $size -h $size -o public/icons/icon-$size.png; done"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/chrome": "^0.3.5",
    "jsdom": "^30.1.3",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.25.0",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  }
}
